# === Base de Datos ===
# Para desarrollo local (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./sanchez_ecommerce.db

# Para producción (PostgreSQL en Neon/Supabase):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# === Seguridad ===
SECRET_KEY=tu-clave-secreta-cambiar-en-produccion-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === Pagos (MercadoPago) ===
# Sacalo de https://www.mercadopago.com.pe/developers/panel
# -> Tu aplicacion -> Credenciales de prueba -> Access Token
MERCADOPAGO_ACCESS_TOKEN=

# En que entorno se cobra: "test" o "produccion". HAY QUE DECLARARLO.
#
# Antes se deducia del prefijo del token —"TEST-" era pruebas— y ya no sirve:
# MercadoPago entrega hoy las credenciales de PRUEBA con el prefijo "APP_USR-",
# el mismo que las de produccion. Sin declararlo, unas credenciales de prueba
# pasarian por reales y el comprador acabaria en el checkout equivocado.
#
# El endpoint /health responde "payments":"test" o "production", asi que se
# puede comprobar desde fuera cual de los dos esta activo.
MERCADOPAGO_ENTORNO=test

# === Imagenes del panel de administracion (Cloudinary) ===
# Copiala tal cual del panel de Cloudinary: Dashboard -> API Environment
# variable. Tiene la forma cloudinary://<api_key>:<api_secret>@<cloud_name>.
# Si se deja vacia, las imagenes que suba el administrador se guardan en la
# base de datos: funciona igual, pero ocupa espacio y las sirve el backend.
CLOUDINARY_URL=
CLOUDINARY_FOLDER=sanchez-tech-store

# === CORS ===
FRONTEND_URL=http://localhost:3000

# URL publica de este backend. Es la que se le da a MercadoPago para que mande
# ahi las notificaciones de pago; en local no le sirve, no puede alcanzarla.
BACKEND_URL=http://localhost:8000

# === App ===
APP_NAME=Sanchez Tech Store
DEBUG=true

# Clave secreta del webhook de MercadoPago.
# Panel -> Tus integraciones -> Webhooks -> Configurar notificaciones.
# Si se deja vacia, el backend no exige la firma de las notificaciones.
MERCADOPAGO_WEBHOOK_SECRET=

# === Correo saliente (SMTP) ===
# Opcional. Si SMTP_HOST queda vacio, los correos (recuperacion de contrasena y
# confirmacion de pedido) se escriben en el log del servidor en lugar de
# enviarse: util para probar en local sin dar de alta un proveedor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Minutos que vive el enlace de recuperacion de contrasena.
RESET_TOKEN_EXPIRE_MINUTES=30
