# === Base de Datos ===
# Para desarrollo local (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./sanchez_ecommerce.db

# Para producción (PostgreSQL en Neon/Supabase):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# === Seguridad ===
SECRET_KEY=tu-clave-secreta-cambiar-en-produccion-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === Pagos (MercadoPago) ===
# Sacalo de https://www.mercadopago.com.pe/developers/panel
# -> Tu aplicacion -> Credenciales de prueba -> Access Token
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxx

# === CORS ===
FRONTEND_URL=http://localhost:3000

# === App ===
APP_NAME=Sanchez Tech Store
DEBUG=true

# Clave secreta del webhook de MercadoPago.
# Panel -> Tus integraciones -> Webhooks -> Configurar notificaciones.
# Si se deja vacia, el backend no exige la firma de las notificaciones.
MERCADOPAGO_WEBHOOK_SECRET=

# === Correo saliente (SMTP) ===
# Opcional. Si SMTP_HOST queda vacio, los correos (recuperacion de contrasena y
# confirmacion de pedido) se escriben en el log del servidor en lugar de
# enviarse: util para probar en local sin dar de alta un proveedor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Minutos que vive el enlace de recuperacion de contrasena.
RESET_TOKEN_EXPIRE_MINUTES=30
